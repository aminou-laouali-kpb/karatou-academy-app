{
  "name": "karatou-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --port 4317 --strictPort --host 127.0.0.1",
    "dev:e2e-prod": "vite --mode e2e-prod --port 4318 --strictPort --host 127.0.0.1",
    "lint": "eslint .",
    "preview": "vite preview",
    "prod:bootstrap": "npm run supabase:push && npm run seed:content && npm run seed:admin",
    "seed:admin": "node scripts/create-supabase-admin.mjs",
    "seed:content": "node scripts/seed-supabase-content.mjs",
    "seed:content:dry": "node scripts/seed-supabase-content.mjs --dry-run",
    "seed:enterprise-admin": "node scripts/create-supabase-enterprise-admin.mjs",
    "supabase:push": "supabase db push --linked --yes",
    "supabase:push:dry": "supabase db push --dry-run --linked",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:profiles-lockdown": "psql \"$DATABASE_URL\" -f scripts/verify-profiles-role-lockdown.sql",
    "test:signup-trigger": "psql \"$DATABASE_URL\" -f scripts/verify-signup-profile-trigger.sql",
    "test:rls": "psql \"$DATABASE_URL\" -f scripts/verify-cross-org-rls.sql",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "validate:release": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/validate-release.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/react": "^10.59.0",
    "@supabase/supabase-js": "^2.57.4",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.30.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/dm-mono": "^5.2.7",
    "@playwright/test": "^1.61.0",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "workbox-window": "^7.4.1"
  }
}

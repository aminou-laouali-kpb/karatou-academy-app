{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --port 4317 --strictPort --host 127.0.0.1",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "supabase:push:dry": "supabase db push --dry-run --linked",
    "supabase:push": "supabase db push --linked --yes",
    "seed:content:dry": "node scripts/seed-supabase-content.mjs --dry-run",
    "seed:content": "node scripts/seed-supabase-content.mjs",
    "seed:admin": "node scripts/create-supabase-admin.mjs",
    "seed:enterprise-admin": "node scripts/create-supabase-enterprise-admin.mjs",
    "prod:bootstrap": "npm run supabase:push && npm run seed:content && npm run seed:admin"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16"
  }
}

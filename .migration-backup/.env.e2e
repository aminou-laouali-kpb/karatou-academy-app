# E2E test mode (loaded via `vite --mode e2e`).
# Forces the deterministic local-demo build so smoke tests never touch the
# real Supabase project. A Vite mode env file overrides .env.local, so the
# empty Supabase values below disable the Supabase client for tests.
VITE_DEMO_ENABLED=true
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

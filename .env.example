VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Local development can keep demo shortcuts enabled.
# Production/staging should set this to false.
VITE_DEMO_ENABLED=true

# Server-side only. Never prefix this with VITE_ and never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Optional seed/admin bootstrap values (npm run seed:admin).
KARATOU_ADMIN_EMAIL=admin@karatou.academy
KARATOU_ADMIN_PASSWORD=change-this-before-production
KARATOU_ADMIN_NAME=Karatou Admin

# Enterprise-admin provisioning (npm run seed:enterprise-admin).
# The org must already exist (seeded by npm run seed:content), e.g. org-pnud-niger.
KARATOU_ENTERPRISE_EMAIL=admin@partner.org
KARATOU_ENTERPRISE_PASSWORD=change-this-before-production
KARATOU_ENTERPRISE_NAME=Partner Admin
KARATOU_ENTERPRISE_ORG_ID=org-pnud-niger

# Bulk-attestation QR signature (client-side HMAC). NOTE: VITE_ vars are bundled
# into the browser, so this is NOT truly secret — it only deters casual tampering.
VITE_ATTESTATION_SECRET=change-this-attestation-secret

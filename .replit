modules = ["nodejs-20"]
entrypoint = "src/main.tsx"
run = "npm run dev"

[nix]
channel = "stable-24_05"
# Headless Chromium needs these to start, which is what `npm run test:e2e`
# drives through Playwright. Without them the browser exits before the first
# test and the failure reads as a timeout.
packages = [
  "glib", "nspr", "nss", "atk", "at-spi2-atk", "at-spi2-core", "dbus",
  "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext",
  "xorg.libXfixes", "xorg.libXrandr", "mesa", "xorg.libxcb", "libxkbcommon",
  "alsa-lib",
]

# Static deployment: build the Vite SPA and serve dist/.
[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"

# Réécriture SPA. L'application route côté client : sans cette règle, un lien
# profond (/login, /verify/:uid, /redeem/:code) répond 404. Le repli
# `public/404.html` rattrape bien la navigation, mais un robot ou un aperçu
# social ne voit qu'une page d'erreur — donc aucun aperçu sur un certificat
# partagé, et aucune indexation des pages profondes.
#
# Le `*` ne vaut qu'en fin de chemin et capture le reste de l'URL. Les fichiers
# réellement présents dans dist/ restent servis tels quels : la documentation
# Replit appelle cela le « shadowing » — quand une réécriture vise un chemin qui
# correspond aussi à un fichier, le fichier gagne. Les assets, robots.txt,
# sitemap.xml et opengraph.jpg ne sont donc pas affectés.
#
# `public/404.html` est conservé : il ne sert plus tant que cette règle est
# active, et redevient le filet si elle disparaît.
[[deployment.rewrites]]
from = "/*"
to = "/index.html"

# Map the Vite dev server (5173) to the public preview.
[[ports]]
localPort = 5173
externalPort = 80

# The two Playwright servers: demo mode on 4317, production mode on 4318.
[[ports]]
localPort = 4317
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 4318
externalPort = 4200
exposeLocalhost = true

# Reinstall dependencies after pulling `main`: a merge that adds a package
# (the Unicode PDF fonts, for instance) otherwise breaks the next build with an
# unresolved import.
[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

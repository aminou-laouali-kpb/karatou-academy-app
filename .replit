modules = ["nodejs-20"]
entrypoint = "src/main.tsx"
run = "npm run dev"

[nix]
channel = "stable-24_05"

# Static deployment: build the Vite SPA and serve dist/.
# In the Replit Deployments UI, enable the single-page-app rewrite so client
# routes like /verify/:uid and /redeem/:code resolve to index.html.
[deployment]
deploymentTarget = "static"
build = ["npm", "run", "build"]
publicDir = "dist"

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 5174
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 9999
externalPort = 3002

[[ports]]
localPort = 24841
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://hijzqsljasbobjrjotjy.supabase.co"

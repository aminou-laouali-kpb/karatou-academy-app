# Production-mode E2E (loaded via `vite --mode e2e-prod`).
# Demo OFF + no Supabase: the hermetic harness for proving production access gating
# (no demo affordances, dashboards redirect logged-out users, /verify is server-only,
# crafted localStorage cannot grant access). A Vite mode env file overrides .env.local.
VITE_DEMO_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
